        AND (YEAR(TSK.TSK_PLANNED_FINISH_DT)   = YEAR(CURRENT_DATE) 
		    OR YEAR(TSK.TSK_PLANNED_FINISH_DT) = YEAR(CURRENT_DATE) + 1)
    ORDER BY  
